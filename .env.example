# Copy to .env.local and fill in real values.
# Also add these in Vercel → Project → Settings → Environment Variables.

# Meta (Facebook) Pixel ID (public — used in browser)
NEXT_PUBLIC_FB_PIXEL_ID=

# Meta Conversions API access token (SECRET — server only, never NEXT_PUBLIC_)
FB_PIXEL_ACCESS_TOKEN=

# Optional: Meta Test Events code for local/dev verification
# FB_TEST_EVENT_CODE=

# Transactional lead email (SERVER ONLY)
# Verify the sending domain in Resend, then add these values in Vercel.
RESEND_API_KEY=
LEAD_FROM_EMAIL="NoorPath Leads <leads@noorpath.online>"
LEAD_TO_EMAIL=info@noorpath.online

# Google AdSense (public — used in browser). Ad units render on blog pages only.
# Client ID is already set in the layout; override here if needed.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6672180310891209
# After approval, create ad units in AdSense → Ads → By ad unit, then paste the
# slot IDs here (and in Vercel). Ads stay hidden until these are set.
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG_BOTTOM=

# NoorPath Intelligence lead ingest (SERVER ONLY — never NEXT_PUBLIC_)
# Browser posts to /api/leads; this server route forwards with the secret.
# INTELLIGENCE_INGEST_URL=http://127.0.0.1:3100/api/leads/ingest
# LEAD_INGEST_SECRET=

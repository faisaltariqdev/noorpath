# Copy to .env.seo (gitignored) and fill only what you enable.
# Never commit real credentials.

# ── Firecrawl (free tier: https://www.firecrawl.dev) ──────────────────────────
FIRECRAWL_API_KEY=

# ── Google Search Console MCP ─────────────────────────────────────────────────
# Enable Search Console API → service account JSON → add SA email in GSC.
GOOGLE_APPLICATION_CREDENTIALS=/Users/mac/Downloads/noorpath/.credentials/gsc-service-account.json
GSC_SITE_URL=sc-domain:noorpath.online

# ── Google Analytics 4 ────────────────────────────────────────────────────────
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# ── Google Sheets (optional) ──────────────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS=/Users/mac/Downloads/noorpath/.credentials/sheets-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Site under audit ──────────────────────────────────────────────────────────
SEO_BASE_URL=https://www.noorpath.online
SEO_LIVE=0

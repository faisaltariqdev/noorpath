{
  // Cloudflare Workers + Static Assets deployment (see CLOUDFLARE-DEPLOY.md).
  // Build command: node scripts/cloudflare-build.mjs   Deploy command: npx wrangler deploy
  "name": "noorpath",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /about serves about.html, /about.html redirects to /about (same as the Vercel site).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the API reaches the Worker; every page and image is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Variables and secrets (RESEND_API_KEY, LEAD_FROM_EMAIL, ...) are managed in the Cloudflare dashboard.
  "keep_vars": true,
  "observability": { "enabled": true }
}
